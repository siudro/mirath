# المتغيرات المحلية — انسخ هذا الملف إلى .env ثم ضع المفتاح الحقيقي.
# .env مستثنى من Git عبر .gitignore. لا ترفع هذا الملف ولا تضع المفتاح في الكود.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# الموديل: لونا GPT-6 مع الرؤية.
MIRATH_WRITER_MODEL=gpt-6-luna
MIRATH_VERIFIER_MODEL=gpt-6-luna

# المنفذ — Railway يضبطه تلقائيًا.
PORT=8080
